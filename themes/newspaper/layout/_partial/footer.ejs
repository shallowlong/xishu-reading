<%
  var seriesList = paper_series_list();
%>
<footer class="paper-foot">
  <div class="paper-foot-inner">
    <div class="foot-col foot-about">
      <h2 class="foot-title">关于本站</h2>
      <p><%= theme.paper.about %></p>
    </div>
    <div class="foot-col">
      <h2 class="foot-title">系列</h2>
      <ul>
        <% seriesList.forEach(function (s) { %>
          <li><a href="<%= url_for('/series/' + s.path + '/') %>"><%= s.name %>（<%= s.count %> 期）</a></li>
        <% }) %>
      </ul>
    </div>
    <div class="foot-col">
      <h2 class="foot-title">索引</h2>
      <ul>
        <li><a href="<%= url_for('/') %>">首页</a></li>
        <li><a href="<%= url_for('/series/') %>">全部系列</a></li>
        <li><a href="<%= url_for('/archives/') %>">内容归档</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <p>本站由 <%= config.author %> 收集 · 整理 · 编排</p>
    <p>© <%= paper_copyright_years() %> <%= config.author %></p>
  </div>
</footer>
